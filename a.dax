RAWDATA_ProjectDate = DATE(RAWDATA[Project Year], 1, 1)
-- Total Sales by Project Date
Proposal Label by ProjectDate1 = 
CALCULATE(
    [Proposal Label],
    USERELATIONSHIP('CALENDAR'[Date], RAWDATA[RAWDATA_ProjectDate])
