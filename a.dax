Calendarnew = CALENDAR(MIN(Sales[Date]),MAX(Sales[Date]))

Total_sales = Orders[Quantity]*Orders[Sales]

total_profit = Orders[Profit]*Orders[Quantity]

total_discount = Orders[Discount]*Orders[Quantity]

total cost = Orders[Total_sales]-Orders[total_profit]

Price_after_dis_Column = Orders[Total_sales]-(Orders[Total_sales]*0.10)






dis_Column_Central = IF(Orders[Region]="Central",Orders[total_sales]-(Orders[total_sales]*0.16),Orders[total_sales])


dis_Column_Central1 = IF(Orders[Region]="East",Orders[total_sales]-(Orders[total_sales]*0.12),Orders[total_sales])

dis_Column_not_Central = IF(Orders[Region]<>"Central",Orders[total_sales]-(Orders[total_sales]*0.05),Orders[total_sales])
Filtercondition_Phoenix = IF(Orders[City]="Phoenix","ACTIVE","NOT_ACTIVE")

Filtercondition_Austin = IF(Orders[City]="Austin","ACTIVE","NOT_ACTIVE")

Filtercondition_Phoenix_not = IF(Orders[City]<>"Phoenix","ACTIVE","NOT_ACTIVE")

Filtercondition_Phoenix_Not_Dis% = IF(Orders[City]<>"Phoenix",Orders[total_sales]-(Orders[total_sales]*0.34),Orders[total_sales])

Discount Price (Tech) = 
IF(
    Orders[Category]="Technology", (Orders[Total Sales]-Orders[Total Sales]*0.20),
    Orders[Total Sales]-Orders[Total Sales]*0.05)
    
Discount Price Non(Tech) = 
IF(
    Orders[Category]<>"Technology", (Orders[Total Sales]-Orders[Total Sales]*0.23),
    Orders[Total Sales]-Orders[Total Sales]*0.04)



--price_after_dis=[Total Sales] - [Total Sales] * 0.30
--disprice=sp-(sp*d%)
myDiscount% = 
IF(
    'Orders'[Category] = "Furniture" && 'Orders'[Sub-Category] = "Chairs",
    [Total Sales] - [Total Sales] * 0.30,
    [Total Sales]
)

myDiscount%_Cat_Regional = 
IF(
    'Orders'[Category] = "Furniture" && 'Orders'[Region] = "East",
