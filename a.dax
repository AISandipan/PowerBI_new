myProposal Label Displaynew = 

//var1
VAR YearSelected = SELECTEDVALUE(YearTable2[Year])
//var2
VAR CountThisYear = 
    CALCULATE(
        COUNT(RAWDATA[Proposal Name]),
        TREATAS({YearSelected}, RAWDATA[Actual Assessement Closer Year])
    )

    //var3
VAR CountLastYear =
    CALCULATE(
        COUNT(RAWDATA[Proposal Name]),
        TREATAS({YearSelected - 1}, RAWDATA[Actual Assessement Closer Year])
    )

    //var4
VAR Change = DIVIDE(CountThisYear - CountLastYear, CountLastYear, 0)
//var5
VAR Arrow = IF(Change > 0, " ↑", IF(Change < 0, " ↓", " →"))
RETURN
    CountThisYear & " (" & FORMAT(Change, "0%") & Arrow & ")"




Proposal Label Display = 
VAR YearSelected = SELECTEDVALUE(YearTable2[Year])
VAR CountThisYear = 
    CALCULATE(
        COUNT(RAWDATA[Proposal Name]),
        TREATAS({YearSelected}, RAWDATA[Actual Assessement Closer Year])
    )
VAR CountLastYear =
    CALCULATE(
        COUNT(RAWDATA[Proposal Name]),
        TREATAS({YearSelected - 1}, RAWDATA[Actual Assessement Closer Year])
    )
VAR Change = DIVIDE(CountThisYear - CountLastYear, CountLastYear, 0)
VAR Arrow = 
    IF(Change > 0, "🟢↑", IF(Change < 0, "🔴↓", " →"))
RETURN
    CountThisYear & " (" & FORMAT(Change, "0%") & Arrow & ")"





























