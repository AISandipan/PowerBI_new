Orders_Color = 

SWITCH(TRUE(),
SUM(Orders[Sales])<= 400000,"#37ff00ff",
SUM(Orders[Sales])<= 690000,"#f620e8ff",
"#FFA500"
)

Orders_Color1 = 

SWITCH(TRUE(),
SUM(Orders[Sales])<= 400000,"#ff0000",
SUM(Orders[Sales])<= 690000,"#0000FF",
"#FFA500"
)

Orders_Color4 = 
SWITCH(
    TRUE(),
    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "Central") <= 400000, "#ff0000",
    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "Central") <= 690000, "#0000FF",
    "#FFA500",

    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "East") <= 400000, "#ff0000",
    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "East") <= 690000, "#0000FF",
    "#FFA500",

    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "South") <= 400000, "#ff0000",
    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "South") <= 690000, "#0000FF",
    "#FFA500",

    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "West") <= 400000, "#ff0000",
    CALCULATE(SUM(Orders[Sales]), Orders[Region] = "West") <= 690000, "#0000FF",
    "#FFA500"
)



Orders_Color6 = 
SWITCH(
    TRUE(),
    Orders[Region] = "Central" && Orders[Sales] <= 400000, "#ff0000",  // Red for Central with sales <= 400,000
    Orders[Region] = "Central" && Orders[Sales] <= 690000, "#0000FF",  // Blue for Central with sales <= 690,000
    Orders[Region] = "Central", "#FFA500",  // Orange for Central with sales > 690,000

    Orders[Region] = "East" && Orders[Sales] <= 400000, "#0000FF",  // Red for East with sales <= 400,000
    Orders[Region] = "East" && Orders[Sales] <= 690000, "#0000FF",  // Blue for East with sales <= 690,000
    Orders[Region] = "East", "#FFA500",  // Orange for East with sales > 690,000

    Orders[Region] = "South" && Orders[Sales] <= 400000, "#ff0000",  // Red for South with sales <= 400,000
    Orders[Region] = "South" && Orders[Sales] <= 690000, "#0000FF",  // Blue for South with sales <= 690,000
    Orders[Region] = "South", "#FFA500",  // Orange for South with sales > 690,000

    Orders[Region] = "West" && Orders[Sales] <= 400000, "#ff0000",  // Red for West with sales <= 400,000
    Orders[Region] = "West" && Orders[Sales] <= 690000, "#0000FF",  // Blue for West with sales <= 690,000
    Orders[Region] = "West", "#FFA500"  // Orange for West with sales > 690,000
)

Highest_Lowest Color4 = 
VAR CurrentSale = SUM(Orders[Sales])

VAR HighestValue =
    MAXX(
        ALLSELECTED(Orders[Sub-Category]),
        CALCULATE(SUM(Orders[Sales]))
    )

VAR LowestValue =
    MINX(
        ALLSELECTED(Orders[Sub-Category]),
        CALCULATE(SUM(Orders[Sales]))
    )

RETURN
IF(
    CurrentSale = HighestValue, "#73B761",     -- Green (highest)
    IF(
        CurrentSale = LowestValue, "#DB271C",  -- Red (lowest)
        "#5AA9E6"                              -- Default blue
    )
)


