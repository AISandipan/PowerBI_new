Average Filtered TTM1 = 
VAR FilteredTable =
    ADDCOLUMNS (
        VALUES('RAWDATA (2)'[SID]),
        "FilteredTTM",
            VAR RawValue = CALCULATE(SELECTEDVALUE('RAWDATA (2)'[TTM(Weeks)]))
            VAR NumValue =
                IF (
                    NOT ISERROR(SEARCH("a", RawValue)) || RawValue = "Not RFL'd",
                    BLANK(),
                    VALUE(RawValue)
                )
            RETURN
                IF (
                    NOT ISBLANK(NumValue) && NumValue < 85.7,
                    NumValue,
                    BLANK()
                )
    )
RETURN
    AVERAGEX(
        FILTER(FilteredTable, NOT ISBLANK([FilteredTTM])),
        [FilteredTTM]
    )




























