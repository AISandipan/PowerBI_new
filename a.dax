        Orders[Region] = "East" || Orders[Region] = "Central", 
        Orders[Total_Sales_New] * 0.15, 
        Orders[Total_Sales_New]
    )


Filtercondition_Phoenix_new6 = 
VAR Price_after_dis_Column = Orders[Total_Sales_Col] - (Orders[Total_Sales_Col] * 0.10)
RETURN
IF(
    Orders[City] <> "Phoenix",
    Price_after_dis_Column,
    0
)







//-----------------------------------Advance DAX------------------------------------------------
-- 1. Discount based on Region
Regional_Discount_Price =
VAR SalesAmount = Orders[Total_sales]
VAR DiscountRate =
    SWITCH(
        Orders[Region],
        "East", 0.12,
        "Central", 0.16,
        "West", 0.08,
        "South", 0.10,
        0
    )
RETURN
    SalesAmount - (SalesAmount * DiscountRate)


-- 2. Discount based on Category
Category_Discount_Price =
VAR SalesAmount = Orders[Total_sales]
VAR DiscountRate =
    SWITCH(
        Orders[Category],
        "Technology", 0.20,
        "Furniture", 0.15,
        "Office Supplies", 0.10,
        0.05
    )
RETURN
    SalesAmount - (SalesAmount * DiscountRate)


-- 3. High Quantity Discount
Quantity_Discount_Price =
VAR SalesAmount = Orders[Total_sales]
VAR Qty = Orders[Quantity]
VAR DiscountRate =
    IF(
        Qty >= 10,
        0.25,
        IF(
            Qty >= 5,
            0.15,
            0.05
        )
    )
RETURN
    SalesAmount - (SalesAmount * DiscountRate)


-- 4. Profit-Based Customer/Order Status
Profit_Status =
VAR ProfitAmount = Orders[total_profit]
RETURN
    IF(
        ProfitAmount > 500,
        "HIGH PROFIT",
        IF(
            ProfitAmount > 0,
            "PROFITABLE",
            "LOSS"
        )
    )


-- 5. Regional + Category Discount
Regional_Category_Discount =
VAR SalesAmount = Orders[Total_sales]
VAR DiscountRate =
    SWITCH(
        TRUE(),
        Orders[Region] = "East" &&
        Orders[Category] = "Technology", 0.30,

        Orders[Region] = "Central" &&
        Orders[Category] = "Furniture", 0.25,

        Orders[Region] = "West" &&
        Orders[Category] = "Office Supplies", 0.20,

        0.05
    )
RETURN
    SalesAmount - (SalesAmount * DiscountRate)


-- 6. Phoenix Special Pricing
Phoenix_Special_Price =
VAR SalesAmount = Orders[Total_sales]
RETURN
    IF(
        Orders[City] = "Phoenix",
        SalesAmount - (SalesAmount * 0.35),
        SalesAmount - (SalesAmount * 0.10)
    )


-- 7. Technology + High Quantity Discount
Tech_HighQty_Discount =
VAR SalesAmount = Orders[Total_sales]
RETURN
    IF(
        Orders[Category] = "Technology" &&
        Orders[Quantity] >= 5,
        SalesAmount - (SalesAmount * 0.30),
        IF(
            Orders[Category] = "Technology",
            SalesAmount - (SalesAmount * 0.20),
            SalesAmount
        )
    )


-- 8. Furniture Chair Special Discount
Furniture_Chair_Discount =
VAR SalesAmount = Orders[Total_sales]
VAR IsChair =
    Orders[Category] = "Furniture" &&
    Orders[Sub-Category] = "Chairs"
RETURN
    IF(
        IsChair,
        SalesAmount - (SalesAmount * 0.30),
        SalesAmount - (SalesAmount * 0.05)
    )


-- 9. Customer/Order Priority
Order_Priority =
VAR SalesAmount = Orders[Total_sales]
VAR ProfitAmount = Orders[total_profit]
RETURN
    SWITCH(
        TRUE(),
        SalesAmount >= 1000 && ProfitAmount > 300, "HIGH PRIORITY",
        SalesAmount >= 500 && ProfitAmount > 100, "MEDIUM PRIORITY",
        SalesAmount < 500 && ProfitAmount > 0, "LOW PRIORITY",
        "CHECK ORDER"
    )


-- 10. Discount Based on Region + City
City_Region_Discount =
VAR SalesAmount = Orders[Total_sales]
VAR DiscountRate =
    SWITCH(
        TRUE(),
        Orders[City] = "Phoenix", 0.34,
        Orders[City] = "Austin" &&
        Orders[Region] = "Central", 0.25,
        Orders[Region] = "East", 0.15,
        Orders[Region] = "Central", 0.20,
        0.05
    )
RETURN
    SalesAmount - (SalesAmount * DiscountRate)


-- 11. Advanced Profit After Discount
Profit_After_Discount =
VAR SalesAmount = Orders[Total_sales]
VAR ProfitAmount = Orders[total_profit]
VAR DiscountRate =
    SWITCH(
        TRUE(),
        Orders[Category] = "Technology" &&
        Orders[Profit] > 0.20, 0.20,

        Orders[Category] = "Furniture" &&
        Orders[Profit] > 0.15, 0.15,

        Orders[Quantity] >= 10, 0.10,

        0.05
    )
VAR DiscountedSales =
    SalesAmount - (SalesAmount * DiscountRate)
RETURN
    DiscountedSales - (SalesAmount - ProfitAmount)


-- 12. Advanced Order Classification
Advanced_Order_Classification =
VAR SalesAmount = Orders[Total_sales]
VAR Qty = Orders[Quantity]
VAR ProfitAmount = Orders[total_profit]
VAR RegionName = Orders[Region]
RETURN
    SWITCH(
        TRUE(),

        SalesAmount >= 2000 &&
        ProfitAmount >= 500 &&
        Qty >= 10,
        "VIP HIGH VALUE",

        SalesAmount >= 1000 &&
        ProfitAmount >= 250 &&
        (RegionName = "East" || RegionName = "Central"),
        "HIGH VALUE",

        SalesAmount >= 500 &&
        ProfitAmount > 0,
        "MEDIUM VALUE",

        ProfitAmount < 0,
        "LOSS ORDER",

        "NORMAL ORDER"
    )























